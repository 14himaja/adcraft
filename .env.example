APP_ENV=development
GEMINI_API_KEY=your-gemini-api-key-here
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=acm
JWT_SECRET=change-me-to-32-or-more-random-characters
TOKEN_ENCRYPTION_KEY=change-me-to-a-valid-32-byte-base64-encryption-key
META_MODE=mock
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
INSTAGRAM_POSITIONS=stream

# --- AI provider: openrouter | gemini | litellm (direct OpenAI) | scripted ---
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-here
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_UTILITY_MODEL=gemini-2.5-flash
MOCK_METRICS=true
FAKE_META_FAIL_AT=
INSIGHTS_INTERVAL_HOURS=6

APP_ID=your-meta-app-id
META_APP_ID=your-meta-app-id
META_LOGIN_CONFIG_ID=your-meta-login-config-id
META_API_VERSION=v26.0
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-user-access-token
META_AD_ACCOUNT_ID=act_your-ad-account-id
META_PAGE_ID=your-facebook-page-id
ALLOW_REAL_AD_SPEND=false
SAFE_MODE_NO_SPEND=true

ADK_SUPPRESS_GEMINI_LITELLM_WARNINGS=true
IMAGE_PROVIDER=fake
OPENAI_IMAGE_MODEL=gpt-image-2

# DM agent and organic Instagram posts
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
PUBLIC_BASE_URL=http://localhost:8000
ALLOW_ORGANIC_PUBLISH=false
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_UTILITY_MODEL=gemini-2.5-flash

# OpenRouter (Optional)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL_FAMILY=gemini
OPENROUTER_GEMINI_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_GEMINI_UTILITY_MODEL=google/gemini-2.5-flash
OPENROUTER_OPENAI_PRIMARY_MODEL=openai/gpt-4o
OPENROUTER_OPENAI_UTILITY_MODEL=openai/gpt-4o-mini
OPENAI_IMAGE_QUALITY=medium

# --- Multi-Platform Social Media OAuth Integrations ---
SOCIAL_OAUTH_MODE=real
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback
# LinkedIn REST API version (YYYYMM). LinkedIn retires versions after about 12 months (426 NONEXISTENT_VERSION).
LINKEDIN_API_VERSION=202611

X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:3000/api/integrations/x/callback

PINTEREST_CLIENT_ID=your-pinterest-client-id
PINTEREST_CLIENT_SECRET=your-pinterest-client-secret
PINTEREST_REDIRECT_URI=http://localhost:3000/api/integrations/pinterest/callback

REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REDIRECT_URI=http://localhost:3000/api/integrations/reddit/callback
REDDIT_USER_AGENT=AdCraft/1.0 (by /u/your_reddit_username)
